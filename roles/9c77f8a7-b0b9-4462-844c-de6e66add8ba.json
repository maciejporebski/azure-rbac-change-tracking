{
  "Name": "Azure AIManager RBAC Reader",
  "Id": "9c77f8a7-b0b9-4462-844c-de6e66add8ba",
  "IsCustom": false,
  "Description": "Allows read-only access to all Kubernetes objects in an Azure AIManager, except Secrets, roles, and role bindings. Applying this role at the AIManager scope will give access across all namespaces.",
  "Actions": [
    "Microsoft.Authorization/*/read",
    "Microsoft.Resources/subscriptions/operationresults/read",
    "Microsoft.Resources/subscriptions/read",
    "Microsoft.Resources/subscriptions/resourceGroups/read"
  ],
  "NotActions": [],
  "DataActions": [
    "Microsoft.ContainerService/aiManagers/*/read",
    "Microsoft.ContainerService/aiManagers/apps/*/read",
    "Microsoft.ContainerService/aiManagers/autoscaling/*/read",
    "Microsoft.ContainerService/aiManagers/batch/*/read",
    "Microsoft.ContainerService/aiManagers/discovery.k8s.io/*/read",
    "Microsoft.ContainerService/aiManagers/events.k8s.io/*/read",
    "Microsoft.ContainerService/aiManagers/extensions/*/read",
    "Microsoft.ContainerService/aiManagers/metrics.k8s.io/*/read",
    "Microsoft.ContainerService/aiManagers/networking.k8s.io/*/read",
    "Microsoft.ContainerService/aiManagers/policy/*/read"
  ],
  "NotDataActions": [
    "Microsoft.ContainerService/aiManagers/secrets/*",
    "Microsoft.ContainerService/aiManagers/rbac.authorization.k8s.io/clusterroles/*",
    "Microsoft.ContainerService/aiManagers/rbac.authorization.k8s.io/clusterrolebindings/*",
    "Microsoft.ContainerService/aiManagers/rbac.authorization.k8s.io/roles/*",
    "Microsoft.ContainerService/aiManagers/rbac.authorization.k8s.io/rolebindings/*"
  ],
  "AssignableScopes": [
    "/"
  ],
  "Condition": null,
  "ConditionVersion": null
}
